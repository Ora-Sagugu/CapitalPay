# CapitalPay — 环境变量模板
# 复制为 .env 并填入实际值

# ── Django ──
DJANGO_SETTINGS_MODULE=b2b_payment.settings.local
DJANGO_SECRET_KEY=change-me-to-random-string
DJANGO_DEBUG=True
ALLOWED_HOSTS=*

# Production example (see deploy/env.production.example):
# DJANGO_SETTINGS_MODULE=b2b_payment.settings.production
# DJANGO_DEBUG=False
# ALLOWED_HOSTS=YOUR_SERVER_IP
# CSRF_TRUSTED_ORIGINS=http://YOUR_SERVER_IP,https://YOUR_SERVER_IP
# CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP,https://YOUR_SERVER_IP
# CASHIER_BASE_URL=http://YOUR_SERVER_IP/customer/pay

# ── Encryption Key (32-byte base64, 用 cryptography.fernet.Fernet.generate_key() 生成) ──
FIELD_ENCRYPTION_KEY=ZmDc7qJ3XkL9pW2vN5sH8aB1eR4uY6tG=

# ── Business ──
ORDER_EXPIRE_MINUTES=30

# ── Database (optional local MySQL 8; omit MYSQL_HOST to keep SQLite) ──
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=b2b_payment
# MYSQL_USER=b2b_payment
# MYSQL_PASSWORD=
# MYSQL_SSL_MODE=DISABLED
# MYSQL_CONN_MAX_AGE=60

# ── Bank / FX (MOCK 直至真实凭证就绪) ──
BANK_GATEWAY_MODE=MOCK
BANK_CODES=MOCK
BANK_RECON_FETCH_MODE=MOCK
BANK_FX_PROVIDER_MODE=MOCK
# BANK_SFTP_HOST=
# BANK_SFTP_USER=
# BANK_SFTP_PASSWORD=
# FX_API_KEY=
# FX_API_URL=https://fx.example.com/rates
# BANK_API_KEYS=ABC:key1,ICBC:key2

# ── SMS ──
SMS_PROVIDER_MODE=MOCK
# SMS_API_URL=
# SMS_API_KEY=
